{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "PLACEHOLDER_HOOK_SCRIPT session-start RUNTIME",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "PLACEHOLDER_HOOK_SCRIPT session-start RUNTIME",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLACEHOLDER_HOOK_SCRIPT user-prompt RUNTIME",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLACEHOLDER_HOOK_SCRIPT post-tool-use RUNTIME",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLACEHOLDER_HOOK_SCRIPT stop RUNTIME",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLACEHOLDER_HOOK_SCRIPT stop-failure RUNTIME",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLACEHOLDER_HOOK_SCRIPT session-end RUNTIME",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
