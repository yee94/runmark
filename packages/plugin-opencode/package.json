{
  "name": "@runmarks/opencode-plugin",
  "icon": "data:image/svg+xml;base64,",
  "version": "0.2.17",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && vite build",
    "prepack": "bun run build",
    "dev": "tsdown --watch",
    "dev:gui": "vite build --watch",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:host": "bun run build && RUNMARK_HOST_TEST=1 bun test __tests__/memory-host.test.ts",
    "typecheck": "tsc -b ../shared && tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@opencode-ai/sdk": "1.17.15",
    "@opencode/plugin": "2.2.5",
    "@agent-tracker/shared": "workspace:*",
    "@types/bun": "latest",
    "solid-js": "^1.9.0",
    "tsdown": "^0.17.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "yaml": "^2.8.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
