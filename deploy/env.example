# Agent Tracker 生产环境配置
# 复制为 /opt/agent-tracker/.env 后由 setup-remote.sh 加载

AGENT_TRACKER_PORT=3456
AGENT_TRACKER_API_KEY=CHANGE_ME
AGENT_TRACKER_DB_PATH=/opt/agent-tracker/packages/server/data/agent-tracker.db
AGENT_TRACKER_PUBLIC_DIR=/opt/agent-tracker/packages/server/public
AGENT_TRACKER_PUBLIC_DASHBOARD=false
AGENT_TRACKER_LOG_FILE=/opt/agent-tracker/packages/server/data/agent-tracker.log

# Built-in Agent LLM provider
# Provider name/base URL/model are seeded into SQLite automatically.
# API key is read from runtime config and is not stored in SQLite.
# AGENT_TRACKER_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# AGENT_TRACKER_LLM_MODEL=gpt-4o-mini
# AGENT_TRACKER_LLM_API_KEY=CHANGE_ME_LLM_API_KEY

# Cursor Usage API 对账（Hook 上报 + Session Token 拉账单）
# 设为 false 可关闭定时同步
AGENT_TRACKER_CURSOR_SYNC_ENABLED=true
# 32 字节 AES 密钥（hex 64 字符或 base64），用于加密存储用户配置的 Session Token
AGENT_TRACKER_CURSOR_CRYPTO_KEY=CHANGE_ME_CURSOR_CRYPTO_KEY

# ============================================================
# 自动更新配置（Runmark Updater）
# 以下均为服务端内置默认值；一般无需配置。仅在要关闭或改路径时覆盖。
# ============================================================
# 启用远端更新检查（默认 true；设为 false 可关闭）
# AGENT_TRACKER_UPDATE_ENABLED=true
# 远端 manifest URL（自托管；无默认官方地址）
# AGENT_TRACKER_UPDATE_MANIFEST_URL=https://example.com/server-manifest.json
# 更新脚本路径
# AGENT_TRACKER_UPDATE_SCRIPT=/opt/runmark-updater/update.sh
# 更新状态持久化路径
# AGENT_TRACKER_UPDATE_STATE_PATH=/opt/runmark-updater/update-state.json
